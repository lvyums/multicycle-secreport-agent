# ═══════════════════════════════════════════════════════
# 多周期网安报告智能体 环境配置模板
# 复制为 .env 后按需修改
# ═══════════════════════════════════════════════════════

# ── 应用 ──
APP_NAME=sec-report-agent
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── 数据库（MySQL8 Docker 默认；镜像拉取失败可切 sqlite:///./sec_report.db 兜底）──
DATABASE_URL=mysql+pymysql://sec_report:sec_report_dev@127.0.0.1:3306/sec_report?charset=utf8mb4

# ── 缓存（redis 默认；无 Redis 时切 memory 兜底）──
CACHE_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# ── LLM（复用日志溯源卫士底座，指向 raytoken deepseek）──
LLM_API_KEY=
LLM_BASE_URL=https://raytoken.com.cn
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_RETRY=2
LLM_FALLBACK_ENABLED=true

# ── 报告存储 ──
REPORT_ROOT=./reports
VECTOR_PERSIST_DIR=./vector_data
TEMPLATE_ROOT=./template

# ── 风险阈值（规则引擎）──
RISK_HIGH_ALERT_THRESHOLD=100
RISK_HIGH_VULN_UNFIXED_THRESHOLD=10
RISK_CLOSED_RATE_THRESHOLD=0.8

# ── 调度（五周期 Cron）──
CRON_DAILY=0 1 * * *
CRON_WEEKLY=30 1 * * 1
CRON_MONTHLY=0 2 1 * *
CRON_QUARTERLY=30 2 1 1,4,7,10 *
CRON_YEARLY=0 3 1 1 *
SCHEDULE_ENABLED=true
